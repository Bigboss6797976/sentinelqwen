# ═══════════════════════════════════════════════════════════════
# SentinelQwen - Environment Configuration Template
# Copy this file to .env and fill in your credentials
# NEVER commit .env to version control
# ═══════════════════════════════════════════════════════════════

# ─── Qwen Cloud / DashScope (Required) ───
# Get your API Key from: https://home.qwencloud.com/api-keys
DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here

# Qwen Model Configuration
QWEN_MODEL=qwen3.7-plus

# ─── Alibaba Cloud (Required for deployment proof) ───
# Get from: https://ram.console.aliyun.com/manage/ak
ALIBABA_CLOUD_ACCESS_KEY_ID=your-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your-access-key-secret
ALIBABA_CLOUD_REGION=ap-southeast-1

# ─── Alibaba Cloud OSS (File storage) ───
ALIBABA_CLOUD_OSS_BUCKET=sentinelqwen-reports
ALIBABA_CLOUD_OSS_ENDPOINT=oss-ap-southeast-1.aliyuncs.com

# ─── Redis (Celery + Memory cache) ───
REDIS_URL=redis://localhost:6379/0

# ─── Telegram Bot (Optional) ───
# Get from @BotFather on Telegram
BOT_TOKEN=your-telegram-bot-token
ADMIN_IDS=your-telegram-user-id

# ─── Blockchain RPCs (Optional) ───
ETH_RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY
BSC_RPC_URL=https://bsc-dataseed.binance.org/
TRON_RPC_URL=https://api.trongrid.io

# ─── Flask Config ───
FLASK_SECRET_KEY=change-this-to-a-random-string-in-production
FLASK_DEBUG=False
FLASK_PORT=5000
FLASK_HOST=0.0.0.0

# ─── Audit Config ───
MAX_CONTRACT_SIZE=50000
DEFAULT_CHAIN=ethereum
AI_TEMPERATURE=0.1
